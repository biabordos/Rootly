# Copy to .env and fill in. Never commit .env.
# Free key: https://console.mistral.ai -> choose the "Experiment" plan (phone verification required).
MISTRAL_API_KEY=

# Any Mistral model with tool calling, e.g. mistral-large-latest, mistral-small-latest.
MISTRAL_MODEL=mistral-large-latest
MAX_REACT_STEPS=15
LOG_LEVEL=INFO
