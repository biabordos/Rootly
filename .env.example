# Copy to .env and fill in. Never commit .env.
# Free key: https://console.mistral.ai -> choose the "Experiment" plan (phone verification required).
MISTRAL_API_KEY= 

# Any Mistral model with tool calling. codestral-latest is the default: on the free
# Experiment plan, mistral-large-latest returns 403 (tier not allowed) and
# mistral-small-latest has been observed at a 0 requests/minute limit until a plan is
# explicitly activated in the console; codestral-latest has worked reliably in testing.
MISTRAL_MODEL=codestral-latest
MAX_REACT_STEPS=15
LOG_LEVEL=INFO

# LangChain-native monitoring (LangSmith). Optional: if LANGSMITH_TRACING is not "true",
# the code runs exactly as before, with no tracing.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=            # key from https://smith.langchain.com (Settings -> API Keys)
LANGSMITH_PROJECT=rootly      # project name runs are grouped under
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # default; EU: https://eu.api.smith.langchain.com
# The legacy LANGCHAIN_TRACING_V2 / LANGCHAIN_API_KEY / LANGCHAIN_PROJECT names are also
# read (installed langsmith==0.12.4 checks LANGSMITH_* first, then falls back to LANGCHAIN_*).
