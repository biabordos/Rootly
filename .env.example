# Copy to .env and fill in. Never commit .env.

# Mistral (agentul)
MISTRAL_API_KEY=cheia_ta_mistral_aici
MISTRAL_MODEL=codestral-latest
# Total model turns per run across all four agents (orchestrator + specialists).
MAX_REACT_STEPS=32
LOG_LEVEL=INFO

# LangSmith (monitorizare LangChain) — pasul (a)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=cheia_ta_langsmith_aici
LANGSMITH_PROJECT=rootly

# Phoenix (opțional — serverul rulează ca Docker container separat)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=rootly
